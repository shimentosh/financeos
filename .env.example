# ---------------------------------------------------------------------------
# Expense Wise — environment
# Copy to `.env` and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
# Public origin of the app. Used for auth callbacks, webhook URLs, and links in
# notification emails.
APP_URL=http://localhost:3100

# --- Database (PostgreSQL) --------------------------------------------------
# `docker compose up -d postgres` starts one on port 5436.
DATABASE_URL=postgres://expensewise:expensewise@localhost:5436/expensewise
# Used only by the PostgreSQL-backed integration tests. Must be a separate
# database: the tests truncate every table.
DATABASE_URL_TEST=postgres://expensewise:expensewise@localhost:5436/expensewise_test

# --- Authentication (Better Auth) -------------------------------------------
# 32+ random bytes. Generate with:  openssl rand -base64 32
BETTER_AUTH_SECRET=
# Set to "false" to stop new sign-ups on a private, single-owner install.
ALLOW_SIGN_UP=true

# --- Encryption -------------------------------------------------------------
# AES-256-GCM key for integration credentials and webhook secrets, base64 of
# exactly 32 bytes. Generate with:  openssl rand -base64 32
# Rotating it makes stored integration credentials unreadable; reconnect them.
ENCRYPTION_KEY=

# --- AI ---------------------------------------------------------------------
# The simplest way: choose the provider, model and key in the app (Admin → AI);
# those settings win over everything below. These are the server defaults.
#
# AI_PROVIDER: anthropic, deepseek, openai, gemini, openrouter, groq, mistral,
# xai, qwen, moonshot, together, ollama, lmstudio, custom (any OpenAI-compatible
# endpoint), or none. With none (or no key) the app runs on its deterministic
# parsers and rules: manual review replaces AI extraction.
AI_PROVIDER=anthropic
# Empty = the provider's recommended model (claude-opus-5, deepseek-flash, gpt-5-mini, …).
AI_MODEL=
# Each provider reads its own key; AI_API_KEY works for whichever AI_PROVIDER names.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
TOGETHER_API_KEY=
AI_API_KEY=
# Endpoint override for OpenAI-compatible providers (required for custom).
AI_BASE_URL=
# Some models (DeepSeek V4 Pro, Llama, …) can't read images. A second model for
# screenshots, receipts and PDFs, e.g. AI_VISION_PROVIDER=gemini.
AI_VISION_PROVIDER=none
AI_VISION_MODEL=
AI_VISION_API_KEY=
AI_VISION_BASE_URL=
# Monthly AI spend ceiling per workspace in USD. Above it, AI features fall
# back to deterministic processing until the next month. 0 disables the cap.
AI_MONTHLY_BUDGET_USD=25

# --- File storage -----------------------------------------------------------
# The simplest way: set up Cloudflare R2 or any S3-compatible bucket in the app
# (Admin → Storage); a bucket saved there wins over everything below for new files.
# "local" writes under STORAGE_LOCAL_DIR (development, single server).
# "s3" uses any S3-compatible store (AWS S3, Cloudflare R2, MinIO, RustFS).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Path-style addressing for MinIO/RustFS.
S3_FORCE_PATH_STYLE=false

# --- Background jobs --------------------------------------------------------
# "true" runs the job worker (queue, domain events, scheduled tasks) inside the
# API process: fine for one server. Set "false" on the API and run
# `pnpm worker` (node dist/worker.js) as its own process to scale out; any
# number of workers can share the queue, and each scheduled task runs once per
# slot however many processes run the scheduler.
RUN_WORKER_IN_PROCESS=true
# Shared secret for POST /api/system/tick (header `x-cron-secret`): one worker
# pass, for hosts without a long-running process, called by an external cron.
CRON_SECRET=

# --- Email ------------------------------------------------------------------
# Verification, password reset, invitations, receipts and alerts are sent
# through Resend. Without a key, emails are written to the API log instead
# (fine for development, not for production).
RESEND_API_KEY=
EMAIL_FROM="Expense Wise <alerts@example.com>"
# Where support requests are delivered.
SUPPORT_EMAIL=
# Sign-in waits for a verified email. Defaults to true when NODE_ENV=production.
REQUIRE_EMAIL_VERIFICATION=

# --- Sign in with Google (optional) -----------------------------------------
# OAuth client from Google Cloud Console; redirect URI:
#   <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Operations -------------------------------------------------------------
# Error reports to Sentry (or a Sentry-compatible service such as GlitchTip).
SENTRY_DSN=
# "json" for one JSON object per log line.
LOG_FORMAT=text
# Express "trust proxy" for the API: decides request.ip (rate limits, audit).
# 1 covers the web server's /api proxy plus one reverse proxy in front of it
# (the web server keeps that proxy's X-Forwarded-For). With a chain in front of
# the web server (a CDN, then a load balancer) use the number of proxies (2).
# Also accepts true, false, or a comma-separated list of proxy addresses.
TRUST_PROXY=1
# Database connections per process.
DATABASE_POOL_MAX=10
# After rotating ENCRYPTION_KEY, list the old key(s) here (comma-separated)
# and run `pnpm --filter @expensewise/api rotate-keys` to re-encrypt.
ENCRYPTION_KEY_PREVIOUS=

# --- API server (NestJS) ---
API_PORT=4100
# Where the web server reaches the API (server-side fetches and the /api proxy).
API_INTERNAL_URL=http://localhost:4100
# Comma-separated emails that receive the platform admin role on sign-up.
ADMIN_EMAILS=
